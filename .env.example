# Neon: Project → Connection Details → "Pooled connection"
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Fellespassord gjestene får på invitasjonen
GUEST_PASSWORD="endre-meg"

# Passord kun for brudeparet (adminpanelet på /admin)
ADMIN_PASSWORD="endre-meg-ogsa"

# Lang tilfeldig streng for signering av innloggings-cookies.
# Lag en med:  openssl rand -base64 32
SESSION_SECRET="lag-en-lang-tilfeldig-streng"
